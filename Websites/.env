# Example .env file for Docker Compose You should add passwords as docker secrets or in Jenkins credentials and not in this file for security reasons. This file is just for development purposes and should not be used in production.
# MYSQL_ROOT_PASSWORD
# MYSQL_PASSWORD
MYSQL_DATABASE=ems_db
MYSQL_USER=appuser
NODE_ENV=production
HOSPITAL_CLIENT_VERSION=1.0.0
HOSPITAL_SERVER_VERSION=1.0.0 
EMS_CLIENT_VERSION=1.0.0
EMS_SERVER_VERSION=1.0.0